{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.github.io/JOY/schemas/living-ledger/JOIN_RECEIPT_V0_1.schema.json",
  "title": "Living Ledger Join Receipt V0.1",
  "description": "Machine-checkable proof-of-link envelope. JOINED is allowed only when independent receipts, matching join fields, compatible provenance, and no scope conflict are all present. Authority is always false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "join_receipt_id",
    "version",
    "valid_time",
    "transaction_time",
    "status",
    "source_receipts",
    "matching_join_fields",
    "independent_provenance",
    "compatible_provenance",
    "scope_conflict",
    "reason",
    "authority"
  ],
  "properties": {
    "join_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "0.1"
    },
    "valid_time": {
      "type": "string",
      "format": "date-time"
    },
    "transaction_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "JOINED",
        "HOLD",
        "NO_JOIN",
        "CONFLICT",
        "SCOPE_MISMATCH"
      ]
    },
    "source_receipts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_id",
          "source_uri",
          "content_sha256",
          "provenance_root"
        ],
        "properties": {
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "source_uri": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provenance_root": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "matching_join_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "left",
          "right",
          "comparison"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "right": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "comparison": {
            "enum": [
              "EQUAL",
              "COMPATIBLE"
            ]
          }
        }
      }
    },
    "independent_provenance": {
      "type": "boolean"
    },
    "compatible_provenance": {
      "type": "boolean"
    },
    "scope_conflict": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "JOINED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_receipts": {
            "minItems": 2
          },
          "matching_join_fields": {
            "minItems": 1
          },
          "independent_provenance": {
            "const": true
          },
          "compatible_provenance": {
            "const": true
          },
          "scope_conflict": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SCOPE_MISMATCH"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "scope_conflict": {
            "const": true
          }
        }
      }
    }
  ]
}
