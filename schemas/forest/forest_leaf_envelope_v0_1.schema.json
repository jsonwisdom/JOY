{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jsonwisdom/JOY/schemas/forest/forest_leaf_envelope_v0_1.schema.json",
  "title": "Forest Leaf Envelope v0.1",
  "description": "Sidecar routing metadata for a canonical receipt. Does not mutate the referenced receipt and cannot create authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id",
    "schema_version",
    "envelope_type",
    "receipt_ref",
    "subject_id",
    "target_id",
    "claim",
    "source_kind",
    "access_scope",
    "operation",
    "source_locator",
    "retrieved_at",
    "candidate_class",
    "root_name",
    "evidence_weight",
    "synthetic",
    "may_resolve_factual_conflict",
    "authority_created"
  ],
  "properties": {
    "envelope_id": {"type": "string", "minLength": 8},
    "schema_version": {"type": "string", "const": "0.1.0"},
    "envelope_type": {"type": "string", "const": "forest_leaf_envelope_v0_1"},
    "receipt_ref": {"type": "string", "minLength": 8},
    "subject_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "claim": {"type": "object"},
    "source_kind": {"type": "string", "enum": ["PUBLIC_SOURCE", "PUBLIC_LOCAL_SOURCE", "BOUNDARY_OBSERVATION", "CREATIVE_REPLAY", "USER_AUTHORIZED_PRIVATE"]},
    "access_scope": {"type": "string", "enum": ["PUBLIC", "USER_AUTHORIZED_PRIVATE", "SYNTHETIC_TEST"]},
    "operation": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "published_at": {"type": ["string", "null"]},
    "retrieved_at": {"type": "string"},
    "candidate_class": {"type": "string", "enum": ["PRIVATE_OR_APPROVED", "PUBLIC_LOCAL", "BOUNDARY_RECEIPT", "CREATIVE", "PUBLIC_SOURCE"]},
    "root_name": {"type": "string", "enum": ["family", "alabama", "apple_blossom", "leah_prime", "public_research"]},
    "conflict_group": {"type": ["string", "null"]},
    "evidence_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "synthetic": {"type": "boolean"},
    "may_resolve_factual_conflict": {"type": "boolean"},
    "authority_created": {"type": "boolean", "const": false}
  }
}
