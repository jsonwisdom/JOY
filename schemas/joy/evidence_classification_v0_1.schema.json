{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jsonwisdom/JOY/schemas/joy/evidence_classification_v0_1.schema.json",
  "title": "JoySpace Evidence Classification v0.1",
  "description": "Routing classification for a JoySpace epistemic receipt. Routing confidence measures classification agreement only; it is not truth confidence. Authority is always false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "primary_class", "routing_confidence", "alternative_classes", "evidence_weight", "root_candidate", "reason_codes", "cross_tree_inference", "authority_created"],
  "properties": {
    "decision": {"type": "string", "enum": ["ROUTE", "HOLD"]},
    "primary_class": {"type": ["string", "null"], "enum": ["PRIVATE_OR_APPROVED", "PUBLIC_LOCAL", "BOUNDARY_RECEIPT", "CREATIVE", "PUBLIC_SOURCE", null]},
    "routing_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "alternative_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["PRIVATE_OR_APPROVED", "PUBLIC_LOCAL", "BOUNDARY_RECEIPT", "CREATIVE", "PUBLIC_SOURCE"]}},
    "evidence_weight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "label"],
      "properties": {
        "level": {"type": "integer", "minimum": 0, "maximum": 2},
        "label": {"type": "string", "enum": ["UNBOUND", "SOURCE_BOUND", "REPLAYED"]}
      }
    },
    "root_candidate": {"type": ["string", "null"], "enum": ["family", "alabama", "apple_blossom", "leah_prime", "public_research", null]},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cross_tree_inference": {"type": "boolean", "const": false},
    "authority_created": {"type": "boolean", "const": false}
  }
}
